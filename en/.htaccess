# Pagina propia en ingles para las direcciones de /en/ que no existen
# El bloque mod_rewrite es copia del de la raiz (../.htaccess): si cambia alli, cambia aqui
# (la copia hace que /en/ no dependa de si LiteSpeed hereda las reglas de la raiz; la cache y nosniff si se heredan)
ErrorDocument 404 /en/404.html
<IfModule mod_rewrite.c>
RewriteEngine On
# index.html va primero y directo a la direccion final: un enlace viejo con http o www da un solo salto propio
# THE_REQUEST es la peticion del navegador: el DirectoryIndex interno (de / a index.html) no la cambia, asi que no hay bucle
RewriteCond %{THE_REQUEST} \s/+([^\s?]*/)?index\.html[\s?]
RewriteRule ^ https://yutorikapital.com/%1 [R=301,L,NE]
# http a https sin bucles: si algun dia un proxy termina el TLS, X-Forwarded-Proto evita redirigir sin fin
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://yutorikapital.com%{REQUEST_URI} [R=301,L,NE]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://yutorikapital.com%{REQUEST_URI} [R=301,L,NE]
</IfModule>
