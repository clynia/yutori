# Yutori Capital: pagina 404, una sola direccion por pagina y cache
# El bloque mod_rewrite tiene una copia en en/.htaccess: si cambia aqui, cambia alli
ErrorDocument 404 /404.html
<IfModule mod_rewrite.c>
RewriteEngine On
# index.html va primero y directo a la direccion final: un enlace viejo con http o www da un solo salto propio
# THE_REQUEST es la peticion del navegador: el DirectoryIndex interno (de / a index.html) no la cambia, asi que no hay bucle
RewriteCond %{THE_REQUEST} \s/+([^\s?]*/)?index\.html[\s?]
RewriteRule ^ https://yutorikapital.com/%1 [R=301,L,NE]
# http a https sin bucles: si algun dia un proxy termina el TLS, X-Forwarded-Proto evita redirigir sin fin
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://yutorikapital.com%{REQUEST_URI} [R=301,L,NE]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://yutorikapital.com%{REQUEST_URI} [R=301,L,NE]
</IfModule>
<IfModule mod_headers.c>
<FilesMatch "\.(css|js)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<FilesMatch "\.(webp|jpg|png|ico|woff2)$">
Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
<FilesMatch "\.(html|xml|txt)$">
Header set Cache-Control "no-cache"
</FilesMatch>
Header set X-Content-Type-Options "nosniff"
</IfModule>
